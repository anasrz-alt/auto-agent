from metagpt import MetaAgent

agent = MetaAgent(
    name="{{ agent_name }}",
    tools=[
        {% for tool in tools %}
        {"name": "{{ tool.name }}", "func": {{ tool.func }}, "description": "{{ tool.description }}"}{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
)

if __name__ == "__main__":
    response = agent.execute("{{ test_prompt }}")
    print("🤖 Result:", response)

def get_weather(city: str) -> str: 
    '''Get weather for a city.'''
    return f"It is always sunny in {city}!"

The list below is rendered dynamically.
"""

{% for tool in tools %}
@tool
def {{ tool.name }}({{ tool.signature }}):
